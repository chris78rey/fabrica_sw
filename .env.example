# Proveedor del modelo: openai u openrouter
FACTORY_MODEL_PROVIDER=openai
FACTORY_MODEL_NAME=gpt-4o-mini

# Credencial del proveedor seleccionado
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Opcional: endpoint compatible con OpenAI para proveedores locales o alternativos
OPENAI_BASE_URL=

# Ruta del repositorio que la fábrica puede inspeccionar/modificar
FABRICA_WORKSPACE_DIR=.

# Solo necesario para la etapa explícita de publicación
GITHUB_TOKEN=
